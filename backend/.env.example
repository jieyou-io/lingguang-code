# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
LOG_JSON=true

# Runtime
SSE_KEEPALIVE_SECONDS=15
MAX_CONCURRENT_SESSIONS=10
SESSION_TIMEOUT_SECONDS=1800

# Codex API
CODEX_API_BASE=http://localhost:9000
CODEX_API_KEY=

# CORS
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Feishu Bot
FEISHU_ENABLE=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_NAME=FeishuBot
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BOT_OPEN_ID=
FEISHU_STATE_PATH=~/.lingguang/feishu_state.json
FEISHU_DEFAULT_ENGINE=claude
FEISHU_DEFAULT_MODEL=claude-sonnet-4-5
FEISHU_REQUIRE_MENTION_DEFAULT=true

# Claude auto-approve permission prompts (web/feishu default y)
CLAUDE_AUTO_APPROVE_PERMISSIONS=true
